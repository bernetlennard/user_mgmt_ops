# Phase 1 scratch work -- see docs/helm-phase1.md. Deliberately never committed.
sandbox/
rendered*.yaml
*.rendered.yaml

# Helm packaging output
*.tgz
charts/*/charts/
charts/*/Chart.lock

# Local-only value overrides (may contain real secrets)
values-local.yaml
*.local.yaml

# Terraform: provider cache, state, plan output, and the token-bearing tfvars file. The lock
# file (.terraform.lock.hcl) IS committed on purpose -- it pins provider versions.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/*.auto.tfvars

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
